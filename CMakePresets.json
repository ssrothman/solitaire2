{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "SOLITAIRE2_BUILD_PYTHON": "ON"
      }
    },
    {
        "name": "debug-cpp",
        "displayName": "DebugCpp",
        "generator": "Unix Makefiles",
        "binaryDir": "${sourceDir}/build/debug-cpp",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
          "SOLITAIRE2_BUILD_PYTHON": "OFF"
        }
      },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SOLITAIRE2_BUILD_PYTHON": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
        "name": "debug-cpp",
        "configurePreset": "debug-cpp"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
        "name": "debug-cpp",
        "configurePreset": "debug-cpp",
        "output": {
          "outputOnFailure": true
        }
    }
  ]
}
